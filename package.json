{
  "name": "zcap-spec-examples",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Extracts the examples from the zcap-spec and prints them to stdout.",
  "type": "module",
  "bin": {
    "zcap-spec-examples": "./dist/zcap-spec-examples.js"
  },
  "main": "./dist/zcap-spec-examples.js",
  "types": "./dist/zcap-spec-examples.d.ts",
  "exports": {
    ".": {
      "types": "./dist/zcap-spec-examples.d.ts",
      "default": "./dist/zcap-spec-examples.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    }
  },
  "files": [
    "dist",
    "zcap-spec-examples.ts",
    "examples.ts",
    "ZcapSpecExamplesCli.ts",
    "nodejs.ts",
    "fixtures.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobengo/zcap-spec-examples.git"
  },
  "homepage": "https://github.com/gobengo/zcap-spec-examples#readme",
  "bugs": {
    "url": "https://github.com/gobengo/zcap-spec-examples/issues"
  },
  "keywords": [
    "zcap",
    "zcap-spec",
    "respec",
    "spec",
    "examples",
    "cli",
    "jsonc"
  ],
  "scripts": {
    "start": "node zcap-spec-examples.ts",
    "start:hardened": "node --permission zcap-spec-examples.ts",
    "tsc": "tsc --noEmit",
    "build:js": "tsc --project etc/tsconfig.build.json && node -e \"fs.chmodSync('dist/zcap-spec-examples.js', 0o755)\"",
    "docs": "typedoc --options etc/typedoc.json",
    "build:website": "node website/build.ts --clean --out build/website",
    "build:gh-pages": "npm run build:website && npm run tsc && typedoc --options etc/typedoc.json --out build/website/docs",
    "dev": "npm run dev:gh-pages",
    "dev:gh-pages": "npm run build:gh-pages && node etc/serve-gh-pages.ts build/website",
    "fixture:update": "node etc/update-fixture.ts",
    "test": "node --test",
    "prepare": "npm run build:js",
    "release": "npm run build:js && npm publish --ignore-scripts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
